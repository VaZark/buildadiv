{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "/packages/*": ["./packages/*"],
      "/examples/*": ["./examples/*"],
      "/lib/query-template.min.js": ["./packages/runtime/standalone.ts"]
    }
  },
  "include": [
    "examples/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "packages/*/vite.config.ts"
  ],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/runtime" },
    { "path": "./packages/builder" }
  ]
}
