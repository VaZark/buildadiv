{
  "name": "buildadiv",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run clean && node node_modules/typescript/bin/tsc -b && node dist/scripts/build.js && npm run build:lib && npm run build:site",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "lint": "vp lint --deny-warnings",
    "test": "npm run build && npm run test:unit",
    "test:browser": "npm run build && playwright test",
    "check": "npm run build && node dist/scripts/validate-architecture.js && npm run format:check && npm run lint && npm run test:unit && playwright test",
    "serve-examples": "npm run build && node dist/tests/support/server.js",
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist',...['shared','runtime','builder'].flatMap((n)=>[`packages/${n}/dist`,`packages/${n}/lib`,`packages/${n}/tsconfig.tsbuildinfo`])])fs.rmSync(p,{recursive:true,force:true})\"",
    "test:unit": "node --test --test-isolation=none dist/tests/unit/**/*.test.js",
    "validate:architecture": "npm run build && node dist/scripts/validate-architecture.js",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "build:site": "node packages/builder/lib/cli.mjs build --config dist/examples/site/buildadiv.config.js",
    "build:lib": "npm run build:lib --workspaces --if-present && node dist/scripts/build.js --libs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "typescript-ast": "npm:typescript@^6.0.3",
    "vite-plus": "^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
