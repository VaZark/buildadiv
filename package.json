{
  "name": "buildadiv",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "buildadiv": "dist/packages/builder/node/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && node dist/scripts/build.js && vp pack && npm run build:site",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --deny-warnings",
    "test": "npm run build && npm run test:unit",
    "test:browser": "npm run build && playwright test",
    "check": "npm run build && node dist/scripts/validate-architecture.js && npm run format:check && npm run lint && npm run test:unit && playwright test",
    "serve-examples": "npm run build && node dist/tests/support/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:unit": "node --test --test-isolation=none dist/tests/unit/**/*.test.js",
    "validate:architecture": "npm run build && node dist/scripts/validate-architecture.js",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "build:site": "node dist/packages/builder/node/cli.js build --config dist/examples/site/buildadiv.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "typescript-ast": "npm:typescript@^6.0.3",
    "vite-plus": "^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
